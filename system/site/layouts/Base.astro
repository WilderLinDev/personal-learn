---
import { Font } from 'astro:assets';
import '../styles/global.css';
import '../../../vault/theme.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
  nav?: 'home' | 'topics' | 'glossary';
}
const { title, nav } = Astro.props;
const links = [
  { href: '/topics/', label: 'Topics', id: 'topics' },
  { href: '/glossary/', label: 'Glossary', id: 'glossary' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-kalam" />
    <title>{title === 'Learning' ? title : `${title} · Learning`}</title>
    <script is:inline>
      (() => {
        let pick = null;
        try {
          pick = localStorage.getItem('learn.theme');
        } catch {}
        const dark = pick ? pick === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70">
      <nav class="mx-auto flex h-14 max-w-5xl items-center gap-6 px-4 sm:px-6" aria-label="Site">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
          <span class="size-2.5 rounded-full bg-brand" aria-hidden="true"></span>
          Learning
        </a>
        <div class="ml-auto flex items-center gap-1 text-sm">
          {links.map((l) => (
            <a
              href={l.href}
              aria-current={nav === l.id ? 'page' : undefined}
              class="rounded-md px-3 py-1.5 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:font-medium"
            >
              {l.label}
            </a>
          ))}
          <ThemeToggle client:load />
        </div>
      </nav>
    </header>
    <slot />
    <footer class="mx-auto mt-24 max-w-5xl border-t px-4 py-8 text-sm text-muted-foreground sm:px-6">
      Learning · lessons written with a tutor, kept as Markdown.
    </footer>
  </body>
</html>
