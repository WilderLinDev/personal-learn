---
import { ArrowLeft, ArrowRight, MessageCircleQuestionMark } from '@lucide/astro';
import Base from './Base.astro';
import Speech from '../components/Speech';
import { ipaMap } from '../lib/ipa';
import { formatDate, kindLabel, type Page, type Topic } from '../lib/site';

interface Props {
  page: Page;
  topic: Topic;
}
const { page, topic } = Astro.props;
const { data } = page;
const lesson = page.kind === 'lessons' ? page : undefined;
const at = topic.lessons.findIndex((p) => p.slug === page.slug);
const prev = lesson && topic.lessons[at - 1];
const next = lesson && topic.lessons[at + 1];
const position = lesson && `${String(at + 1)} of ${String(topic.lessons.length)}`;
const ipa = ipaMap([data.title, data.lead, page.entry.body ?? ''].join(' '));
const meta = [
  formatDate(data.date),
  data.updated && `Updated ${formatDate(data.updated)}`,
  lesson?.data.minutes && `${String(lesson.data.minutes)} min read`,
].filter(Boolean);
const sources = page.kind === 'lessons' ? [page.data.source] : page.data.sources;
const further = lesson?.data.further ?? [];
const related = lesson ? topic.reference : topic.lessons;
---

<Base title={data.title}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <nav class="flex items-center justify-between pt-8 text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a
        href={`/topics/${topic.slug}/`}
        class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground"
      >
        <ArrowLeft class="size-4" />
        {topic.title}
      </a>
      {position && <span class="tabular-nums">{position}</span>}
    </nav>

    <header class="pt-10 pb-8">
      <p class="inline-flex items-center rounded-full border bg-tint px-2.5 py-0.5 text-xs font-medium text-brand">
        {kindLabel(page)}
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl sm:leading-[1.1]">{data.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-pretty text-muted-foreground sm:text-xl">{data.lead}</p>
      {lesson?.data.summary && <p class="mt-3 text-base text-muted-foreground">{lesson.data.summary}</p>}
      <p class="mt-6 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted-foreground">
        {meta.map((m, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span>{m}</span>
          </>
        ))}
      </p>
    </header>

    <main id="main" class="prose border-t pt-4 pb-8 dark:prose-invert">
      <slot />
    </main>

    <footer class="grid gap-8 border-t pt-10">
      <section>
        <h2 class="eyebrow">{lesson ? 'Primary source' : 'Sources'}</h2>
        <ul class="mt-3 grid gap-1.5 text-sm">
          {sources.map((l) => (
            <li>
              <a class="font-medium text-brand underline-offset-4 hover:underline" href={l.url}>
                {l.title}
              </a>
            </li>
          ))}
        </ul>
        {further.length > 0 && (
          <>
            <h3 class="eyebrow mt-5">Further reading</h3>
            <ul class="mt-3 grid gap-1.5 text-sm">
              {further.map((l) => (
                <li>
                  <a class="underline-offset-4 hover:underline" href={l.url}>
                    {l.title}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

      {(prev ?? next) && (
        <nav class="grid gap-3 sm:grid-cols-2" aria-label="Lessons">
          {prev ? (
            <a
              href={prev.url}
              class="group rounded-xl border p-4 transition-colors hover:border-brand/40 hover:bg-tint"
            >
              <span class="flex items-center gap-1 text-xs text-muted-foreground">
                <ArrowLeft class="size-3.5" />
                Previous
              </span>
              <span class="mt-1 block font-medium">{prev.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {next && (
            <a
              href={next.url}
              class="group rounded-xl border p-4 text-right transition-colors hover:border-brand/40 hover:bg-tint"
            >
              <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                Next
                <ArrowRight class="size-3.5" />
              </span>
              <span class="mt-1 block font-medium">{next.data.title}</span>
            </a>
          )}
        </nav>
      )}

      {related.length > 0 && (
        <section>
          <h2 class="eyebrow">{lesson ? 'Reference' : 'Lessons'}</h2>
          <ul class="mt-3 grid gap-1.5 text-sm">
            {related.map((r) => (
              <li>
                <a class="underline-offset-4 hover:underline" href={r.url}>
                  {!lesson && `${kindLabel(r)}: `}
                  {r.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {lesson && (
        <p class="flex items-center gap-2.5 rounded-xl bg-muted px-4 py-3 text-sm text-muted-foreground">
          <MessageCircleQuestionMark class="size-4 shrink-0" />
          Anything unclear? Ask your tutor a follow-up question.
        </p>
      )}
    </footer>
  </div>
  <Speech client:idle ipa={ipa} />
  <script>
    import '../islands/mount';
  </script>
</Base>
