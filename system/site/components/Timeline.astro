---
import { formatDay, kindLabel, lastChange, type Page, type Topic } from '../lib/site';

interface Props {
  pages: Page[];
  topics: Topic[];
}
const { pages, topics } = Astro.props;
const days = Map.groupBy(pages, (p) => lastChange(p).toISOString().slice(0, 10));
const topicTitle = (slug: string) => topics.find((t) => t.slug === slug)?.title ?? slug;
---

<ol class="relative grid gap-6 border-l pl-6">
  {[...days].map(([day, items]) => (
    <li class="relative">
      <span
        class="absolute top-1.5 -left-[1.6rem] size-2 rounded-full bg-border ring-4 ring-background"
        aria-hidden="true"
      />
      <time class="text-xs font-medium text-muted-foreground tabular-nums">{formatDay(new Date(day))}</time>
      <ul class="mt-1.5 grid gap-1.5">
        {items.map((p) => (
          <li class="flex flex-wrap items-baseline gap-x-2">
            <a href={p.url} class="font-medium underline-offset-4 hover:text-brand hover:underline">
              {p.data.title}
            </a>
            <span class="text-xs text-muted-foreground">
              {kindLabel(p)} · {topicTitle(p.topic)}
              {p.data.updated && ' · updated'}
            </span>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
