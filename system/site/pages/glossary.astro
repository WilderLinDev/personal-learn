---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { loadSite, parseGlossary } from '../lib/site';

const site = await loadSite();
const glossaries = await getCollection('glossaries');
const topics = site.topics
  .map((t) => ({ topic: t, groups: parseGlossary(glossaries.find((g) => g.id.split('/')[0] === t.slug)?.body ?? '') }))
  .filter((t) => t.groups.length > 0);
---
<Base title="Glossary" nav="glossary">
  <main id="main" class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <h1 class="text-4xl font-semibold tracking-tight">Glossary</h1>
    {topics.length === 0 ? (
      <p class="mt-6 text-muted-foreground">Terms appear here once you can explain and use them.</p>
    ) : (
      <>
        <input
          class="mt-8 h-11 w-full rounded-lg border border-input bg-transparent px-4 text-base shadow-xs outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50"
          type="search" placeholder="Search terms" aria-label="Search terms" data-glossary-search
        />
        {topics.map(({ topic, groups }) => (
          <section class="mt-12" data-glossary-topic>
            <h2 class="text-xs font-semibold tracking-wider text-muted-foreground uppercase"><a class="hover:text-brand" href={`/topics/${topic.slug}/`}>{topic.title}</a></h2>
            {groups.map((g) => (
              <>
                {g.group && <h3 class="mt-6 text-sm font-semibold">{g.group}</h3>}
                <dl class="mt-3 divide-y rounded-xl border">
                  {g.terms.map((t) => (
                    <div class="px-5 py-4" data-glossary-term>
                      <dt class="font-semibold">{t.term}</dt>
                      <dd class="mt-1 text-[0.9375rem] leading-relaxed text-muted-foreground">
                        {t.definition}
                        {t.avoid && <span class="mt-1.5 block text-xs">Avoid: {t.avoid}</span>}
                      </dd>
                    </div>
                  ))}
                </dl>
              </>
            ))}
          </section>
        ))}
        <p class="mt-8 text-muted-foreground" data-glossary-empty hidden>No matching terms.</p>
      </>
    )}
  </main>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-glossary-search]');
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      document.querySelectorAll<HTMLElement>('[data-glossary-topic]').forEach((section) => {
        let any = false;
        section.querySelectorAll<HTMLElement>('[data-glossary-term]').forEach((term) => {
          const hit = !q || term.textContent!.toLowerCase().includes(q);
          term.hidden = !hit;
          any ||= hit;
          if (hit) shown++;
        });
        section.hidden = !any;
      });
      document.querySelector<HTMLElement>('[data-glossary-empty]')!.hidden = shown > 0;
    });
  </script>
</Base>
