---
import Base from '../../layouts/Base.astro';
import TopicCards from '../../components/TopicCards.astro';
import { loadSite } from '../../lib/site';

const site = await loadSite();
---

<Base title="Topics" nav="topics">
  <main id="main" class="mx-auto max-w-5xl px-4 pt-12 sm:px-6 sm:pt-16">
    <h1 class="text-4xl font-semibold tracking-tight">Topics</h1>
    <div class="mt-8">
      <TopicCards topics={site.topics} />
    </div>
  </main>
</Base>
