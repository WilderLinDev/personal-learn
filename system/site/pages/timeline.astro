---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { formatMonth, lastChange, loadSite } from '../lib/site';

const site = await loadSite();
const months = Map.groupBy(site.timeline, (p) => formatMonth(lastChange(p)));
---

<Base title="Timeline" nav="home">
  <main id="main" class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <h1 class="text-4xl font-semibold tracking-tight">Timeline</h1>
    {[...months].map(([month, pages]) => (
      <section class="mt-12">
        <h2 class="eyebrow mb-5">{month}</h2>
        <Timeline pages={pages} topics={site.topics} />
      </section>
    ))}
  </main>
</Base>
