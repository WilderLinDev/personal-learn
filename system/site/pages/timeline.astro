---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import { formatMonth, groupBy, lastChange, loadSite } from '../lib/site';

const site = await loadSite();
const months = groupBy(site.timeline, (p) => formatMonth(lastChange(p)));
---
<Base title="Timeline" nav="home">
  <main id="main" class="mx-auto max-w-3xl px-4 pt-12 sm:px-6 sm:pt-16">
    <h1 class="text-4xl font-semibold tracking-tight">Timeline</h1>
    {months.map((m) => (
      <section class="mt-12">
        <h2 class="mb-5 text-xs font-semibold tracking-wider text-muted-foreground uppercase">{m.key}</h2>
        <Timeline pages={m.items} topics={site.topics} />
      </section>
    ))}
  </main>
</Base>
